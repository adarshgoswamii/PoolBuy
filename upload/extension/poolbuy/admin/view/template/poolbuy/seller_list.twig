{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <a href="{{ add }}" data-bs-toggle="tooltip" title="{{ button_add }}" class="btn btn-primary"><i class="fa-solid fa-plus" aria-hidden="true"></i></a>
        <button type="submit" form="form-seller" formaction="{{ delete }}" data-bs-toggle="tooltip" title="{{ button_delete }}" class="btn btn-danger" data-oc-toggle="confirm" data-oc-confirm="{{ text_confirm }}"><i class="fa-solid fa-trash-can" aria-hidden="true"></i></button>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-store" aria-hidden="true"></i> {{ text_list }}</div>
      <div class="card-body">
        <div id="seller">{{ list }}</div>
      </div>
    </div>
  </div>
</div>
{{ footer }}
