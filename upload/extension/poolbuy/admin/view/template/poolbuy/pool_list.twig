{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <a href="{{ add }}" data-bs-toggle="tooltip" title="{{ text_add }}" class="btn btn-primary"><i class="fa-solid fa-circle-plus" aria-hidden="true"></i> {{ text_add }}</a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="row mb-3">
      <div class="col-md-4">
        <div class="card h-100">
          <div class="card-body">
            <p class="text-muted text-uppercase small mb-1">{{ text_total_volume }}</p>
            <h3 class="mb-1">{{ statistics.total_volume }}</h3>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card h-100">
          <div class="card-body">
            <p class="text-muted text-uppercase small mb-1">{{ text_active_pools }}</p>
            <h3 class="mb-1">{{ statistics.active_pools }}</h3>
            <small class="text-muted"><i class="fa-regular fa-hourglass" aria-hidden="true"></i> {{ text_closing_soon|format(statistics.closing_soon) }}</small>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card h-100">
          <div class="card-body">
            <p class="text-muted text-uppercase small mb-1">{{ text_average_fill }}</p>
            <h3 class="mb-1">{{ statistics.average_fill }}%</h3>
          </div>
        </div>
      </div>
    </div>
    {# Expandable detail panel, loaded when a campaign row is opened #}
    <div id="pool-detail"></div>
    <div class="card">
      <div class="card-header">
        <i class="fa-solid fa-layer-group" aria-hidden="true"></i> {{ text_list }}
        <div class="small text-muted">{{ text_subtitle }}</div>
      </div>
      <div class="card-body">
        <div id="pool">{{ list }}</div>
      </div>
    </div>
  </div>
</div>
{{ footer }}
