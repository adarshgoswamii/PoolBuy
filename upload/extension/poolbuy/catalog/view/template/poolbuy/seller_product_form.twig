{{ header }}
{# Server-rendered product form. Plain POST with multipart encoding for the image,
   so it works with JavaScript unavailable and survives a refresh. #}
<div class="pb-container pb-section">
  <nav aria-label="Breadcrumb" class="pb-mb-lg">
    <ol class="pb-flex pb-wrap pb-gap-sm pb-label-md pb-muted" style="list-style: none; padding: 0; margin: 0;">
      {% for breadcrumb in breadcrumbs %}
        <li>
          {% if not loop.last %}<a class="pb-link" href="{{ breadcrumb.href }}">{{ breadcrumb.text }}{% if breadcrumb.text|striptags|trim is empty %}<span class="pb-visually-hidden">Home</span>{% endif %}</a>
            <i class="fa-solid fa-chevron-right" style="font-size: 9px; margin-inline: 4px;" aria-hidden="true"></i>
          {% else %}<span aria-current="page">{{ breadcrumb.text }}</span>{% endif %}
        </li>
      {% endfor %}
    </ol>
  </nav>

  {{ tabs }}

  <div style="max-width: 46rem;">
    <h1 class="pb-display-lg pb-mb-lg">{{ text_form }}</h1>

    {% if errors %}
      <div class="pb-alert pb-alert--error pb-mb-lg" role="alert">
        <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
        <span>{{ error_check_form }}</span>
      </div>
    {% endif %}

    {% if not is_approved %}
      <div class="pb-alert pb-alert--warning pb-mb-lg" role="status">
        <i class="fa-solid fa-hourglass-half" aria-hidden="true"></i>
        <span>{{ text_pending_body }}</span>
      </div>
    {% endif %}

    <form action="{{ action }}" method="post" enctype="multipart/form-data">
      <div class="pb-card pb-mb-lg">
        <div class="pb-card__body">
          <h2 class="pb-headline-sm pb-mb-md">{{ text_general }}</h2>

          <div class="pb-field">
            <label class="pb-label" for="pb-name">{{ entry_name }}</label>
            <input class="pb-input" type="text" id="pb-name" name="name" value="{{ name }}" maxlength="255" required
                   aria-describedby="pb-help-name{% if errors.name %} pb-error-name{% endif %}"
                   {% if errors.name %}aria-invalid="true"{% endif %}>
            <p class="pb-body-md pb-muted pb-mt-xs pb-mb-0" id="pb-help-name">{{ help_name }}</p>
            {% if errors.name %}<p class="pb-error-text" id="pb-error-name">{{ errors.name }}</p>{% endif %}
          </div>

          <div class="pb-field">
            <label class="pb-label" for="pb-description">{{ entry_description }}</label>
            <textarea class="pb-input" id="pb-description" name="description" rows="5"
                      aria-describedby="{% if errors.description %}pb-error-description{% endif %}"
                      {% if errors.description %}aria-invalid="true"{% endif %}>{{ description }}</textarea>
            {% if errors.description %}<p class="pb-error-text" id="pb-error-description">{{ errors.description }}</p>{% endif %}
          </div>

          <div class="pb-field">
            <label class="pb-label" for="pb-model">{{ entry_model }}</label>
            <input class="pb-input" type="text" id="pb-model" name="model" value="{{ model }}" maxlength="64"
                   aria-describedby="pb-help-model{% if errors.model %} pb-error-model{% endif %}"
                   {% if errors.model %}aria-invalid="true"{% endif %}>
            <p class="pb-body-md pb-muted pb-mt-xs pb-mb-0" id="pb-help-model">{{ help_model }}</p>
            {% if errors.model %}<p class="pb-error-text" id="pb-error-model">{{ errors.model }}</p>{% endif %}
          </div>
        </div>
      </div>

      <div class="pb-card pb-mb-lg">
        <div class="pb-card__body">
          <h2 class="pb-headline-sm pb-mb-md">{{ text_pricing }}</h2>

          <div class="pb-grid pb-grid-2" style="gap: var(--pb-md);">
            <div class="pb-field">
              <label class="pb-label" for="pb-price">{{ entry_price }}</label>
              <input class="pb-input" type="text" id="pb-price" name="price" value="{{ price }}" inputmode="decimal" required
                     aria-describedby="pb-help-price{% if errors.price %} pb-error-price{% endif %}"
                     {% if errors.price %}aria-invalid="true"{% endif %}>
              <p class="pb-body-md pb-muted pb-mt-xs pb-mb-0" id="pb-help-price">{{ help_price }}</p>
              {% if errors.price %}<p class="pb-error-text" id="pb-error-price">{{ errors.price }}</p>{% endif %}
            </div>

            <div class="pb-field">
              <label class="pb-label" for="pb-quantity">{{ entry_quantity }}</label>
              <input class="pb-input" type="text" id="pb-quantity" name="quantity" value="{{ quantity }}" inputmode="numeric" required
                     aria-describedby="pb-help-quantity{% if errors.quantity %} pb-error-quantity{% endif %}"
                     {% if errors.quantity %}aria-invalid="true"{% endif %}>
              <p class="pb-body-md pb-muted pb-mt-xs pb-mb-0" id="pb-help-quantity">{{ help_quantity }}</p>
              {% if errors.quantity %}<p class="pb-error-text" id="pb-error-quantity">{{ errors.quantity }}</p>{% endif %}
            </div>
          </div>

          <div class="pb-field">
            <label class="pb-flex pb-gap-sm" for="pb-status" style="align-items: flex-start;">
              <input type="checkbox" id="pb-status" name="status" value="1"{% if status %} checked{% endif %}{% if not is_approved %} disabled{% endif %}
                     aria-describedby="pb-help-status{% if errors.status %} pb-error-status{% endif %}"
                     {% if errors.status %}aria-invalid="true"{% endif %}>
              <span class="pb-body-md">{{ entry_status }}</span>
            </label>
            <p class="pb-body-md pb-muted pb-mt-xs pb-mb-0" id="pb-help-status">{{ help_status }}</p>
            {% if errors.status %}<p class="pb-error-text" id="pb-error-status">{{ errors.status }}</p>{% endif %}
          </div>
        </div>
      </div>

      <div class="pb-card pb-mb-lg">
        <div class="pb-card__body">
          <h2 class="pb-headline-sm pb-mb-md">{{ text_image }}</h2>

          <div class="pb-flex pb-gap-md pb-wrap pb-items-end">
            <div>
              <p class="pb-label pb-mb-xs">{{ text_current_image }}</p>
              <img src="{{ thumb }}" alt="" width="80" height="80" loading="lazy">
            </div>

            <div class="pb-field" style="flex: 1 1 18rem;">
              <label class="pb-label" for="pb-image">{{ entry_image }}</label>
              <input class="pb-input" type="file" id="pb-image" name="image" accept="image/jpeg,image/png,image/webp"
                     aria-describedby="pb-help-image{% if errors.image %} pb-error-image{% endif %}"
                     {% if errors.image %}aria-invalid="true"{% endif %}>
              <p class="pb-body-md pb-muted pb-mt-xs pb-mb-0" id="pb-help-image">{{ help_image }}</p>
              {% if errors.image %}<p class="pb-error-text" id="pb-error-image">{{ errors.image }}</p>{% endif %}
            </div>
          </div>
        </div>
      </div>

      <div class="pb-flex pb-gap-sm pb-wrap">
        <button class="pb-btn pb-btn--primary" type="submit">{{ button_save }}</button>
        <a class="pb-btn pb-btn--ghost" href="{{ back }}">{{ button_back }}</a>
      </div>
    </form>
  </div>
</div>
{{ footer }}
