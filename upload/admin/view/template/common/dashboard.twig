{{ header }}{{ column_left }}
<style>
/* Executive Rabreez Super Admin Control Center Theme */
:root {
  --pb-navy: #0F1D36;
  --pb-navy-dark: #091224;
  --pb-navy-light: #EEF3F9;
  --pb-orange: #E06214;
  --pb-orange-dark: #C4510D;
  --pb-orange-light: #FFF4ED;
  --pb-gold: #C89D46;
  --pb-gold-light: #FBF6EB;
  --pb-slate: #0F172A;
  --pb-body: #334155;
  --pb-muted: #64748B;
  --pb-bg: #FAF8F5;
  --pb-card: #FFFFFF;
  --pb-border: #E2E8F0;
  --pb-radius: 16px;
}

#content {
  background: var(--pb-bg) !important;
  font-family: 'Inter', system-ui, -apple-system, sans-serif !important;
  color: var(--pb-slate) !important;
  padding: 0 0 60px 0 !important;
  min-height: 100vh;
  margin-left: 240px !important;
  width: calc(100% - 240px) !important;
  box-sizing: border-box !important;
  transition: margin-left 0.3s ease, width 0.3s ease;
}

@media (max-width: 991.98px) {
  #content {
    margin-left: 0 !important;
    width: 100% !important;
  }
}

/* Style OpenCart top header and left navigation to match Executive theme */
#header {
  background: #091224 !important;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1) !important;
}
#header .navbar-brand {
  display: flex !important;
  align-items: center;
  gap: 8px;
  font-family: 'Playfair Display', Georgia, serif;
  font-weight: 700;
  color: #FAF8F5 !important;
}
#header .nav-link {
  color: #CBD5E1 !important;
}
#column-left {
  background: #091224 !important;
  border-right: 1px solid rgba(255, 255, 255, 0.08) !important;
}
#column-left #navigation {
  background: #0F1D36 !important;
  color: #C89D46 !important;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}
#column-left a {
  color: #94A3B8 !important;
}
#column-left a:hover, #column-left li.active > a {
  color: #FFFFFF !important;
  background: rgba(224, 98, 20, 0.15) !important;
  border-left: 3px solid #E06214;
}

/* Hide default OpenCart page header */
.page-header { display: none !important; }

/* Notice bar */
.pb-admin-banner {
  background: var(--pb-navy-dark);
  color: #FFFFFF;
  padding: 10px 32px;
  font-size: 12px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}
.pb-admin-banner .pill {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: rgba(200, 157, 70, 0.2);
  color: var(--pb-gold);
  border: 1px solid rgba(200, 157, 70, 0.4);
  padding: 2px 10px;
  border-radius: 20px;
  font-weight: 600;
  font-size: 11px;
}
.pb-pulse-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #22C55E;
  display: inline-block;
  box-shadow: 0 0 8px #22C55E;
}

/* Header bar */
.pb-exec-header {
  background: #FFFFFF;
  border-bottom: 1px solid var(--pb-border);
  padding: 18px 32px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 28px;
  box-shadow: 0 1px 3px rgba(15, 29, 54, 0.05);
}
.pb-exec-brand {
  display: flex;
  align-items: center;
  gap: 14px;
}
.pb-exec-logo {
  width: 44px;
  height: 44px;
  background: linear-gradient(135deg, var(--pb-navy), #1A365D);
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 20px;
  box-shadow: 0 4px 12px rgba(15, 29, 54, 0.2);
}
.pb-exec-titles h1 {
  font-family: 'Playfair Display', Georgia, serif;
  font-size: 22px;
  font-weight: 700;
  color: var(--pb-navy);
  margin: 0;
  line-height: 1.2;
}
.pb-exec-titles h1 span { color: var(--pb-orange); }
.pb-exec-titles p {
  font-size: 12px;
  color: var(--pb-muted);
  margin: 0;
}
.pb-exec-actions {
  display: flex;
  align-items: center;
  gap: 12px;
}

.pb-btn-action {
  background: linear-gradient(135deg, var(--pb-orange), var(--pb-orange-dark));
  color: #FFFFFF !important;
  border: none;
  border-radius: 30px;
  padding: 9px 20px;
  font-size: 13px;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  text-decoration: none;
  box-shadow: 0 3px 10px rgba(224, 98, 20, 0.3);
  transition: all 0.2s;
}
.pb-btn-action:hover {
  transform: translateY(-1px);
  box-shadow: 0 5px 14px rgba(224, 98, 20, 0.4);
}
.pb-btn-light-action {
  background: #FFFFFF;
  color: var(--pb-navy) !important;
  border: 1px solid var(--pb-border);
  border-radius: 30px;
  padding: 8px 18px;
  font-size: 13px;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  text-decoration: none;
  transition: all 0.2s;
}
.pb-btn-light-action:hover {
  background: var(--pb-navy-light);
  border-color: var(--pb-navy);
}

/* Metric Cards */
.pb-metric-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 20px;
  padding: 0 32px;
  margin-bottom: 32px;
}
.pb-stat-card {
  background: #FFFFFF;
  border: 1px solid var(--pb-border);
  border-radius: var(--pb-radius);
  padding: 24px;
  box-shadow: 0 2px 8px rgba(15, 29, 54, 0.04);
  transition: transform 0.2s, box-shadow 0.2s;
}
.pb-stat-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 18px rgba(15, 29, 54, 0.08);
}
.pb-stat-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
}
.pb-stat-label {
  font-size: 12px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--pb-muted);
}
.pb-stat-icon {
  width: 38px;
  height: 38px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
}
.pb-stat-val {
  font-family: 'Playfair Display', Georgia, serif;
  font-size: 30px;
  font-weight: 700;
  color: var(--pb-navy);
  margin-bottom: 6px;
}
.pb-stat-hint {
  font-size: 12px;
  color: var(--pb-muted);
}

/* Main Section Layout */
.pb-main-layout {
  padding: 0 32px;
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 24px;
  margin-bottom: 32px;
}
@media (max-width: 1024px) {
  .pb-main-layout { grid-template-columns: 1fr; }
}

.pb-panel {
  background: #FFFFFF;
  border: 1px solid var(--pb-border);
  border-radius: var(--pb-radius);
  overflow: hidden;
  box-shadow: 0 2px 8px rgba(15, 29, 54, 0.04);
}
.pb-panel-head {
  padding: 20px 24px;
  border-bottom: 1px solid var(--pb-border);
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.pb-panel-title {
  font-family: 'Playfair Display', Georgia, serif;
  font-size: 18px;
  font-weight: 700;
  color: var(--pb-navy);
  margin: 0;
  display: flex;
  align-items: center;
  gap: 10px;
}
.pb-panel-body {
  padding: 24px;
}

/* Pool Table */
.pb-table-wrap {
  overflow-x: auto;
}
.pb-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 13px;
}
.pb-table th {
  background: #F8FAFC;
  padding: 12px 16px;
  font-weight: 700;
  color: var(--pb-muted);
  text-transform: uppercase;
  font-size: 11px;
  letter-spacing: 0.06em;
  text-align: left;
  border-bottom: 1px solid var(--pb-border);
}
.pb-table td {
  padding: 14px 16px;
  border-bottom: 1px solid #EDF2F7;
  vertical-align: middle;
}
.pb-table tr:hover td {
  background: #FBFDFF;
}

.pb-badge-status {
  padding: 4px 10px;
  border-radius: 20px;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  display: inline-block;
}
.pb-badge-active { background: #DCFCE7; color: #166534; }
.pb-badge-reached { background: #FEF3C7; color: #92400E; }
.pb-badge-expired { background: #F1F5F9; color: #475569; }

.pb-progress-mini {
  width: 100%;
  height: 6px;
  background: #E2E8F0;
  border-radius: 3px;
  overflow: hidden;
  margin-top: 6px;
}
.pb-progress-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #E06214, #F97316);
  border-radius: 3px;
}

/* Seller Card */
.pb-seller-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 0;
  border-bottom: 1px solid #EDF2F7;
}
.pb-seller-item:last-child { border-bottom: none; }
.pb-seller-info {
  display: flex;
  align-items: center;
  gap: 12px;
}
.pb-seller-avatar {
  width: 40px;
  height: 40px;
  border-radius: 10px;
  background: var(--pb-navy-light);
  color: var(--pb-navy);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 14px;
}

/* OpenCart Legacy Toggle */
.pb-legacy-toggle {
  padding: 0 32px 20px 32px;
}
</style>

<div id="content">
  <!-- Top Notice Bar -->
  <div class="pb-admin-banner">
    <div style="display: flex; align-items: center; gap: 12px;">
      <span class="pill"><span class="pb-pulse-dot"></span> PROTOCOL V4.1 ACTIVE</span>
      <span>Escrow Safeguard &middot; Zero-Defect Climate Audit &middot; Live Wholesale Governance</span>
    </div>
    <div style="display: flex; align-items: center; gap: 16px;">
      <span><i class="fa-solid fa-server" style="color: #C89D46;"></i> MySQL 5.7 &middot; PHP 8.2 &middot; OpenCart 4</span>
      <a href="http://localhost/index.php?route=extension/poolbuy/pool" target="_blank" style="color: #C89D46; text-decoration: none; font-weight: 600;"><i class="fa-solid fa-arrow-up-right-from-square"></i> Open Storefront</a>
    </div>
  </div>

  <!-- Executive Header -->
  <div class="pb-exec-header">
    <div class="pb-exec-brand">
      <div class="pb-exec-logo">
        <i class="fa-solid fa-diagram-project"></i>
      </div>
      <div class="pb-exec-titles">
        <h1>PoolBuy <span>Super Admin</span></h1>
        <p>Enterprise Wholesale Governance, Pool State Machine &amp; Escrow Ledgers</p>
      </div>
    </div>
    <div class="pb-exec-actions">
      <a href="index.php?route=extension/poolbuy/module/poolbuy&user_token={{ user_token }}" class="pb-btn-light-action">
        <i class="fa-solid fa-sliders"></i> Module Config
      </a>
      <a href="http://localhost:8080" target="_blank" class="pb-btn-light-action">
        <i class="fa-solid fa-database"></i> Database Adminer
      </a>
      <button type="button" class="pb-btn-action" onclick="alert('Audit Engine: All 11 wholesale pools validated against Climate Safe protocol and MOQ thresholds.');">
        <i class="fa-solid fa-bolt"></i> Run Platform Audit
      </button>
    </div>
  </div>

  <!-- KPI Metrics Grid -->
  <div class="pb-metric-grid">
    <div class="pb-stat-card">
      <div class="pb-stat-top">
        <span class="pb-stat-label">Active Buying Pools</span>
        <div class="pb-stat-icon" style="background: #EFF6FF; color: #2563EB;">
          <i class="fa-solid fa-cubes"></i>
        </div>
      </div>
      <div class="pb-stat-val">{{ metric_active_pools }}</div>
      <div class="pb-stat-hint"><i class="fa-solid fa-chart-line" style="color: #16A34A;"></i> {{ metric_total_pools }} Total campaigns in catalog</div>
    </div>

    <div class="pb-stat-card">
      <div class="pb-stat-top">
        <span class="pb-stat-label">Gross Escrow Volume</span>
        <div class="pb-stat-icon" style="background: #FEF3C7; color: #D97706;">
          <i class="fa-solid fa-vault"></i>
        </div>
      </div>
      <div class="pb-stat-val">&#8377;{{ metric_escrow_val|number_format(0) }}</div>
      <div class="pb-stat-hint"><i class="fa-solid fa-shield-halved" style="color: #2563EB;"></i> Held under Platform Escrow Custody</div>
    </div>

    <div class="pb-stat-card">
      <div class="pb-stat-top">
        <span class="pb-stat-label">Verified KYC Sellers</span>
        <div class="pb-stat-icon" style="background: #ECFDF5; color: #059669;">
          <i class="fa-solid fa-circle-check"></i>
        </div>
      </div>
      <div class="pb-stat-val">{{ metric_verified_sellers }}</div>
      <div class="pb-stat-hint"><i class="fa-solid fa-id-card" style="color: #059669;"></i> 100% GST &amp; BIS Audit Cleared</div>
    </div>

    <div class="pb-stat-card">
      <div class="pb-stat-top">
        <span class="pb-stat-label">MOQ Unlocked / Near</span>
        <div class="pb-stat-icon" style="background: #FFF7ED; color: #EA580C;">
          <i class="fa-solid fa-trophy"></i>
        </div>
      </div>
      <div class="pb-stat-val">{{ metric_moq_unlocked }}</div>
      <div class="pb-stat-hint"><i class="fa-solid fa-bolt" style="color: #EA580C;"></i> Volume Tier Discount Activated</div>
    </div>
  </div>

  <!-- Main Section: Pool Governance Table + Seller Verification Queue -->
  <div class="pb-main-layout">
    <!-- Left: Pool Lifecycle Governance -->
    <div class="pb-panel">
      <div class="pb-panel-head">
        <h2 class="pb-panel-title">
          <i class="fa-solid fa-list-check" style="color: #E06214;"></i>
          Real-Time Pool Governance &amp; State Machine
        </h2>
        <span style="font-size: 12px; color: #64748B;">Showing Live OpenCart Pools</span>
      </div>
      <div class="pb-table-wrap">
        <table class="pb-table">
          <thead>
            <tr>
              <th>Reference &amp; Product</th>
              <th>Manufacturer</th>
              <th>MOQ Progress</th>
              <th>Deadline</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            {% for pool in poolbuy_pools %}
              <tr>
                <td>
                  <div style="font-weight: 700; color: #0F1D36;">{{ pool.reference }}</div>
                  <div style="color: #475569; font-size: 12px; max-width: 280px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                    {{ pool.title }}
                  </div>
                  {% if pool.climate_safe %}
                    <span style="display: inline-block; font-size: 10px; background: #EEF2FF; color: #4338CA; border: 1px solid #C7D2FE; padding: 1px 6px; border-radius: 4px; margin-top: 3px;">
                      <i class="fa-solid fa-shield-halved"></i> Climate Safe
                    </span>
                  {% endif %}
                </td>
                <td>
                  <div style="font-weight: 600;">{{ pool.seller_name }}</div>
                  <div style="font-size: 11px; color: #94A3B8;">{{ pool.seller_location }}</div>
                </td>
                <td style="min-width: 140px;">
                  <div style="display: flex; justify-content: space-between; font-size: 11px; font-weight: 600;">
                    <span>{{ pool.reserved_qty }} / {{ pool.moq_target }} {{ pool.unit_label }}</span>
                    <span style="color: #E06214;">{{ pool.progress_pct }}%</span>
                  </div>
                  <div class="pb-progress-mini">
                    <div class="pb-progress-bar-fill" style="width: {{ pool.progress_pct }}%;"></div>
                  </div>
                </td>
                <td style="font-size: 12px; color: #64748B;">{{ pool.date_end }}</td>
                <td>
                  <span class="pb-badge-status {% if pool.status == 'active' %}pb-badge-active{% elseif pool.status == 'reached' %}pb-badge-reached{% else %}pb-badge-expired{% endif %}">
                    {{ pool.status }}
                  </span>
                </td>
                <td>
                  <a href="http://localhost/index.php?route=product/product&product_id={{ pool.product_id }}" target="_blank" class="btn btn-sm btn-outline-secondary" title="View Storefront" style="padding: 2px 8px; font-size: 11px;">
                    <i class="fa-solid fa-eye"></i>
                  </a>
                </td>
              </tr>
            {% else %}
              <tr><td colspan="6" style="text-align:center; padding: 20px;">No pools found in database.</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Right: Verified Sellers & Platform Escrow Summary -->
    <div style="display: flex; flex-direction: column; gap: 24px;">
      <!-- Seller KYC Queue -->
      <div class="pb-panel">
        <div class="pb-panel-head">
          <h2 class="pb-panel-title" style="font-size: 16px;">
            <i class="fa-solid fa-building-circle-check" style="color: #16A34A;"></i>
            Verified Wholesale Sellers
          </h2>
          <span style="font-size: 11px; color: #16A34A; font-weight: 700;">KYC APPROVED</span>
        </div>
        <div class="pb-panel-body" style="padding: 16px 20px;">
          {% for seller in poolbuy_sellers %}
            <div class="pb-seller-item">
              <div class="pb-seller-info">
                <div class="pb-seller-avatar">
                  {{ seller.name|slice(0, 2)|upper }}
                </div>
                <div>
                  <div style="font-weight: 700; font-size: 13px; color: #0F1D36;">{{ seller.name }}</div>
                  <div style="font-size: 11px; color: #64748B;">{{ seller.location }} &middot; GSTIN: {{ seller.gstin }}</div>
                </div>
              </div>
              <div style="text-align: right;">
                <span style="font-size: 11px; font-weight: 700; color: #D97706;">★ {{ seller.rating }}</span>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>

      <!-- Escrow & Settlement Ledger Vault -->
      <div class="pb-panel">
        <div class="pb-panel-head">
          <h2 class="pb-panel-title" style="font-size: 16px;">
            <i class="fa-solid fa-scale-balanced" style="color: #2563EB;"></i>
            Platform Ledger &amp; Escrow
          </h2>
        </div>
        <div class="pb-panel-body">
          <div style="display: flex; justify-content: space-between; margin-bottom: 12px; font-size: 13px;">
            <span style="color: #64748B;">Platform Commission:</span>
            <span style="font-weight: 700; color: #0F1D36;">2.00% Net Fee</span>
          </div>
          <div style="display: flex; justify-content: space-between; margin-bottom: 12px; font-size: 13px;">
            <span style="color: #64748B;">GST Compliance Ledger:</span>
            <span style="font-weight: 700; color: #0F1D36;">18.00% Automated</span>
          </div>
          <div style="display: flex; justify-content: space-between; margin-bottom: 16px; font-size: 13px;">
            <span style="color: #64748B;">Settlement State Machine:</span>
            <span style="font-weight: 700; color: #16A34A;">Atomic T+3 Payout</span>
          </div>
          <button class="btn btn-sm btn-outline-primary w-100" onclick="alert('Settlement Ledger: All pool commitments are locked in escrow until MOQ release condition is cleared.');">
            <i class="fa-solid fa-download"></i> Export Escrow Audit Report
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Toggle for OpenCart Legacy Dashboard Widgets -->
  <div class="pb-legacy-toggle">
    <div style="background: #FFFFFF; border: 1px dashed #CBD5E1; border-radius: 12px; padding: 14px 20px; display: flex; align-items: center; justify-content: space-between;">
      <div>
        <span style="font-weight: 700; color: #0F1D36; font-size: 13px;">Classic OpenCart Widgets &amp; System Panels</span>
        <p style="font-size: 11px; color: #64748B; margin: 0;">Access default OpenCart order stats and analytics.</p>
      </div>
      <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#legacy-opencart-widgets">
        Toggle System Widgets
      </button>
    </div>

    <div class="collapse mt-3" id="legacy-opencart-widgets">
      {% for row in rows %}
        <div class="row">
          {% for dashboard_1 in row %}
            {% set class = 'col-lg-%s %s'|format(dashboard_1.width, 'col-md-3 col-sm-6') %}
            <div class="{{ class }} mb-3">{{ dashboard_1.output }}</div>
          {% endfor %}
        </div>
      {% endfor %}
    </div>
  </div>

  {{ security }}
</div>
{{ footer }}