# PoolBuy / OpenCart configuration reference
#
# NOTE: OpenCart does not read a .env file at runtime. Real configuration lives in
#   upload/config.php  and  upload/admin/config.php  (both gitignored),
# and PoolBuy settings live in the MySQL `oc_setting` table (module_poolbuy_*).
#
# This file documents the values a deployer must supply, as placeholders, so the
# required configuration is discoverable. Copy the relevant values into the
# config.php files (or the Docker environment) for your target host.

# --- Database (written into upload/config.php DB_* constants) ---
DB_DRIVER=mysqli
DB_HOSTNAME=your-mysql-host
DB_PORT=3306
DB_USERNAME=your-db-user
DB_PASSWORD=your-db-password
DB_DATABASE=opencart
DB_PREFIX=oc_

# --- Store URLs (HTTP_SERVER in config.php / admin/config.php) ---
HTTP_SERVER=https://your-domain/
HTTP_ADMIN=https://your-domain/admin/

# --- PoolBuy module settings (stored in oc_setting, set via Admin > Extensions > PoolBuy) ---
POOLBUY_CURRENCY_CODE=INR
POOLBUY_CURRENCY_SYMBOL=₹
POOLBUY_GST_RATE=18
POOLBUY_PLATFORM_FEE=2
POOLBUY_POOL_DURATION=7
POOLBUY_RETRO_PRICING=1
# Secret required to trigger the lifecycle cron over HTTP. Generate a random value.
POOLBUY_CRON_TOKEN=change-me-to-a-random-secret
